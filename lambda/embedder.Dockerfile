# Embedder Lambda image.
#
# Image-size target: ~2 GB (BGE-small ~130 MB + SPLADE ~500 MB pre-baked,
# plus FastEmbed + LanceDB + pyarrow + project source).
# Pre-baking the embedding models removes the cold-start tax of downloading
# ~630 MB from the Hugging Face Hub on the first invocation; it is the reason
# this image is ten times the size of the chunker's.
#
# Tag scheme: scripts/build_embedder_image.sh computes sha256(pyproject +
# uv.lock + this Dockerfile + src/ tree) with `-dirty` suffix on uncommitted state.

FROM public.ecr.aws/lambda/python:3.12
# python:3.12 is AL2023-based (glibc 2.34); python:3.11 is AL2-based (glibc 2.26).
# Modern pyarrow + numpy ship only manylinux_2_28 wheels (need glibc 2.28+),
# so AL2 forces source-builds that fail without a C compiler. AL2023 accepts
# the wheels directly. Our code is 3.11+ compatible — no semantic change.

# Cache locations — keep models inside the image's read-only layer at /var/task
# so AWS Lambda's filesystem-cold-start doesn't have to hydrate them.
ENV HF_HOME=/var/task/.cache/huggingface
ENV FASTEMBED_CACHE_PATH=/var/task/.cache/fastembed

# Full embedder dep set. Versions are locked in lambda/requirements-embedder.txt
# (regenerated by scripts/lock_lambda_deps.sh from requirements-embedder.in).
# Locking matters more here than in the chunker: this image carries fastembed,
# lancedb, pyarrow, numpy, onnxruntime and a transitive Rust toolchain — any of
# them silently bumping a major version between builds is a production-grade
# foot-gun. Build is x86_64 (Lambda default; see scripts/build_embedder_image.sh)
# so hf-xet, ONNX runtime, and other native packages have prebuilt manylinux
# wheels. arm64 cross-builds would source-compile hf-xet and fail in the
# Lambda base image (no `cc` linker).
COPY lambda/requirements-embedder.txt /tmp/requirements-embedder.txt
RUN pip install --no-cache-dir --target "${LAMBDA_TASK_ROOT}" \
    -r /tmp/requirements-embedder.txt

# Project source.
COPY src/onebucket_demo ${LAMBDA_TASK_ROOT}/onebucket_demo

# Pre-bake the embedding models. These calls warm FastEmbed's model cache
# (BGE-small for dense, SPLADE for sparse). Each model download is ~130 MB
# + ~500 MB respectively; baking them in saves the cold-start round-trip on
# the first runtime invocation.
RUN python -c "from onebucket_demo.embed_dense import embed_dense; embed_dense(['warmup'])"
RUN python -c "from onebucket_demo.embed_sparse import embed_sparse, compute_canary_hash; \
    embed_sparse(['warmup']); compute_canary_hash()"

# Defensive: confirm the embedder module imports cleanly with all deps in place.
RUN python -c "import onebucket_demo.lambda_handler_embedder"

CMD ["onebucket_demo.lambda_handler_embedder.handler"]
