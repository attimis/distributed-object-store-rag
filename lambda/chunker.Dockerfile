# Chunker Lambda image.
#
# Image-size target: ~200 MB.
# Deliberately omits FastEmbed, LanceDB, pyarrow, numpy. Chunker only invokes
# pipeline.chunk_and_write which uses tokenizers + storage helpers + boto3.
# Verified at test-time by tests/test_lambda_handler_chunker.py
# (test_chunker_does_not_transitively_import_fastembed_or_lancedb).
#
# Tag scheme: scripts/build_chunker_image.sh computes a content hash of the
# build inputs (see that script) with a `-dirty` suffix on uncommitted state.

FROM public.ecr.aws/lambda/python:3.12
# python:3.12 is AL2023-based (glibc 2.34); python:3.11 was AL2 (glibc 2.26).
# Kept consistent with the embedder image so both Lambdas run on the same
# runtime semantics. Our code is 3.11+ compatible — no semantic change.

# Chunker-specific deps only — no FastEmbed, no LanceDB, no pyarrow.
# Build is x86_64 (Lambda default) so hf-xet's prebuilt manylinux wheel is
# available; arm64 builds would force a source-compile of hf-xet via Rust,
# which fails in the Lambda base image (no `cc` linker). See
# scripts/build_chunker_image.sh for the --platform=linux/amd64 flag.
#
# Install from the locked requirements file (regenerated by
# scripts/lock_lambda_deps.sh). This is what guarantees the image content hash
# is reproducible across machines — the inline `>=` floor-pins this replaces
# would otherwise let pip resolve to whatever PyPI happens to ship today.
COPY lambda/requirements-chunker.txt /tmp/requirements-chunker.txt
RUN pip install --no-cache-dir --target "${LAMBDA_TASK_ROOT}" \
    -r /tmp/requirements-chunker.txt

# HF_HOME must be set BEFORE the bake so the tokenizer cache lands inside the
# image (under /var/task) instead of /root/.cache. At runtime Lambda's
# filesystem is read-only outside /tmp, and the runtime user's home directory
# (/home/sbx_user*) is read-only — without this var, Tokenizer.from_pretrained
# falls back to its default cache, can't find the baked assets, tries to
# re-download, and crashes with "[Errno 30] Read-only file system". The
# embedder image does the same dance for its FastEmbed model cache.
ENV HF_HOME=/var/task/.cache/huggingface

# Pre-warm BGE-small tokenizer (chunking.chunk_text uses it).
# This downloads tokenizer.json once at build time so first-invoke avoids the
# Hugging Face round-trip. Tokenizer assets are ~5 MB, not the heavy ~700 MB
# embedder model bundle.
RUN python -c "from tokenizers import Tokenizer; Tokenizer.from_pretrained('BAAI/bge-small-en-v1.5')"

# Project source. Must come AFTER pip install so the handler module is
# discoverable from the LAMBDA_TASK_ROOT sys.path entry.
COPY src/onebucket_demo ${LAMBDA_TASK_ROOT}/onebucket_demo

# Verify the chunker module imports without pulling embedder-stack deps
# (defensive — if a future refactor breaks the lazy-import discipline, the
# image build itself fails rather than the deployed Lambda failing at runtime).
RUN python -c "import onebucket_demo.lambda_handler_chunker; \
    import sys; \
    bad = [m for m in sys.modules if m.split('.')[0] in ('fastembed','lancedb','pyarrow')]; \
    assert not bad, f'chunker image transitively imports embedder-stack: {bad}'"

CMD ["onebucket_demo.lambda_handler_chunker.handler"]
